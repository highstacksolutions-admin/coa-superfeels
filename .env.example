# Super Feels COA — environment. Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Behind a reverse proxy (Hostinger, nginx) in production: set both to 1.
TRUST_PROXY=0
FORCE_HTTPS=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=superfeels_coa
DB_USER=root
DB_PASSWORD=

# Applies pending migrations on boot, and creates the first admin from the
# BOOTSTRAP_ADMIN_* values below if no admin exists yet. Safe to leave on.
AUTO_MIGRATE=1
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-now

# 32+ random characters in production. Generate: openssl rand -hex 32
SESSION_SECRET=

# Lab report PDFs live OUTSIDE the web root — the app refuses to boot if this
# path is inside ./public. Product images are public and served from ./public.
STORAGE_PATH=./storage/coa
UPLOADS_PATH=./public/uploads
MAX_UPLOAD_SIZE=33554432

# Leave SMTP empty to run without email: contact-form enquiries are still
# stored and readable in the admin, just not emailed. Port 465 = SMTP_SECURE=1
# (implicit TLS); 587 = SMTP_SECURE=0 (STARTTLS). MAIL_FROM must be on the same
# domain as SMTP_USER or most hosts reject the send.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Super Feels <mail@coa.superfeels.com>
MAIL_REPLY_TO=
# Where contact-form enquiries are sent. Defaults to MAIL_FROM's address.
CONTACT_RECIPIENT=

# Optional analytics tag (e.g. Plausible/GA snippet) injected into every page.
ANALYTICS_SNIPPET=
ANALYTICS_SCRIPT_SRC=
ANALYTICS_CONNECT_SRC=

LOG_LEVEL=debug
