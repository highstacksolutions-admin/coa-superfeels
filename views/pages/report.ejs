<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main">

  <section class="rpt__top">
    <div class="wrap">
      <p class="mono-meta rpt__crumb"><a href="/" style="text-decoration:none">Batch lookup</a> / Report</p>

      <div class="rpt__head">
        <div>
          <h1 class="rpt__prod"><%= batch.product_name || 'Certificate of analysis' %></h1>
          <p class="rpt__code">
            <%= batch.batch_code %>
            <span>Batch number</span>
          </p>
        </div>
      </div>

      <% if (batch.product_size || primaryFile) { %>
        <div class="meta">
          <% if (batch.product_size) { %>
            <div class="meta__i">
              <p class="meta__l">Size</p>
              <p class="meta__v"><%= batch.product_size %></p>
            </div>
          <% } %>
          <% if (primaryFile) { %>
            <div class="meta__i">
              <p class="meta__l">Report posted</p>
              <p class="meta__v"><%= fmt.date(primaryFile.created_at) %></p>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">

      <%# The lab's own document is the report — nothing on this page is re-typed
          from it, so the page cannot disagree with the lab. It is shown in full,
          embedded rather than hidden behind a link, with the download and
          open-in-tab actions alongside it. %>
      <% if (primaryFile) { %>
        <div class="doc">
          <div class="dl">
            <div class="dl__t">
              <p class="dl__h">The laboratory's report</p>
              <p class="dl__m">PDF · <%= fmt.bytes(primaryFile.file_size) %> · unaltered</p>
            </div>
            <%# The hrefs are the no-JS fallback and would hit the network (and
                so a download-manager extension). Once the viewer has the bytes,
                report-pdf.js rewrites both to act on an in-page blob: URL, which
                such extensions cannot intercept — so with JS on, neither button
                ever touches IDM. %>
            <div class="dl__a">
              <a class="btn btn--ghost btn--sm" href="/download/<%= primaryFile.id %>?inline=1" target="_blank" rel="noopener" data-pdf-open>Open full screen</a>
              <a class="btn btn--solid btn--sm" href="/download/<%= primaryFile.id %>" data-pdf-download>Download PDF</a>
            </div>
          </div>

          <%# The report is drawn onto canvases by PDF.js from base64 text it
              fetches itself, rather than embedded with the browser's PDF plugin.
              That is what makes it render the same on every device and keeps a
              download-manager extension (IDM and the like) from ever seeing a
              PDF response to grab. Progressively filled by /js/report-pdf.js. %>
          <div class="doc__view" data-pdf
               data-src="/download/<%= primaryFile.id %>?embed=1"
               data-code="<%= batch.batch_code %>"
               data-worker="<%= asset('/js/vendor/pdfjs/pdf.worker.min.js') %>">
            <div class="doc__status" data-pdf-status>
              <span class="doc__spin" aria-hidden="true"></span>
              Loading the report…
            </div>
            <div class="doc__pages" data-pdf-pages hidden></div>
            <noscript>
              <div class="doc__fallback">
                <p>Turn on JavaScript to read the report here, or open the PDF directly.</p>
                <a class="btn btn--solid btn--sm" href="/download/<%= primaryFile.id %>?inline=1" target="_blank" rel="noopener">Open the PDF</a>
              </div>
            </noscript>
          </div>
        </div>

        <% if (files.length > 1) { %>
          <p class="mono-meta" style="margin-top:18px">More documents for this batch</p>
          <div class="sibs">
            <% files.filter(function (f) { return f.id !== primaryFile.id; }).forEach(function (f) { %>
              <a class="sib" href="/download/<%= f.id %>?inline=1" target="_blank" rel="noopener"><%= f.label || f.original_filename %> · <%= fmt.bytes(f.file_size) %></a>
            <% }) %>
          </div>
        <% } %>
      <% } else { %>
        <div class="notice">
          <strong>Report not posted yet</strong>
          The laboratory's PDF for this batch will be posted here shortly — <a href="/contact?batch=<%= encodeURIComponent(batch.batch_code) %>" style="color:inherit">ask us for it</a> if you need it now.
        </div>
      <% } %>

      <% if (siblings.length) { %>
        <div class="rsec">
          <div class="rsec__h">
            <h2 class="rsec__t">Other batches of this product</h2>
          </div>
          <p class="rsec__d">Each report covers only the batch it names. These are here for reference — check the code on the item you are holding.</p>
          <div class="sibs">
            <% siblings.forEach(function (s) { %>
              <a class="sib" href="/coa/<%= encodeURIComponent(s.batch_code) %>"><%= s.batch_code %></a>
            <% }) %>
          </div>
        </div>
      <% } %>

      <div class="rsec">
        <p class="rsec__d">
          Something here not matching the product in your hand?
          <a href="/contact?batch=<%= encodeURIComponent(batch.batch_code) %>" style="color:var(--o-deep)">Tell us about it</a>.
        </p>
      </div>

    </div>
  </section>

</main>

<% if (primaryFile) { %>
  <%# Loaded only on a report that has a PDF. Both deferred, so they run in DOM
      order after parsing: the library defines window.pdfjsLib, then the
      renderer uses it. %>
  <script src="<%= asset('/js/vendor/pdfjs/pdf.min.js') %>" defer></script>
  <script src="<%= asset('/js/report-pdf.js') %>" defer></script>
<% } %>

<%- include('../partials/footer') %>
<%- include('../partials/foot') %>
