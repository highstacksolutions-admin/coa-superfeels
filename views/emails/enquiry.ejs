<% var subject = enquiry.batch_code ? 'COA enquiry — batch ' + enquiry.batch_code : 'COA enquiry' %>
<%- include('./partials/head', { subject: subject }) %>

<p style="margin:0 0 10px;font-family:'JetBrains Mono',Menlo,monospace;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:#CE4F16;">New enquiry</p>

<h1 style="margin:0 0 16px;font-family:Helvetica,Arial,sans-serif;font-size:22px;line-height:1.2;color:#21252B;">
  <%= enquiry.subject || 'Someone asked about a batch' %>
</h1>

<%# The batch code leads, because it is the one field that decides what happens
    next: either it is a code we published and something is wrong with the
    report, or it is a code we have never seen. %>
<% if (enquiry.batch_code) { %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px;background:#F5EFE4;border-left:3px solid #F0701C;">
    <tr><td style="padding:14px 16px;">
      <p style="margin:0 0 4px;font-family:'JetBrains Mono',Menlo,monospace;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:#6B7280;">Batch code given</p>
      <p style="margin:0;font-family:'JetBrains Mono',Menlo,monospace;font-size:17px;font-weight:700;letter-spacing:.08em;color:#21252B;"><%= enquiry.batch_code %></p>
    </td></tr>
  </table>
<% } %>

<p style="margin:0 0 20px;white-space:pre-wrap;"><%= enquiry.message %></p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 8px;border-top:1px solid #E4DACA;">
  <tr><td style="padding-top:18px;font-size:14px;color:#6B7280;">
    From <strong style="color:#3A4048;"><%= enquiry.name %></strong> &lt;<a href="mailto:<%= enquiry.email %>" style="color:#CE4F16;"><%= enquiry.email %></a>&gt;<br>
    Reply to this message and it goes straight back to them.
  </td></tr>
</table>

<table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0 0;">
  <tr><td style="background:#F0701C;">
    <a href="<%= url %>" style="display:inline-block;padding:14px 26px;font-family:'JetBrains Mono',Menlo,monospace;font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#ffffff;text-decoration:none;">Open in the admin</a>
  </td></tr>
</table>

<%- include('./partials/foot') %>
