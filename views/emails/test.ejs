<% var subject = 'Test — Super Feels COA' %>
<%- include('./partials/head', { subject: subject }) %>

<h1 style="margin:0 0 16px;font-family:Helvetica,Arial,sans-serif;font-size:24px;line-height:1.15;color:#21252B;">
  Email is working.
</h1>

<p style="margin:0 0 16px;">
  This is a test sent from the Super Feels COA admin panel. If you are reading it, the
  application can reach the mail server and the mail server accepted the message — so a
  customer enquiry will reach you too.
</p>

<p style="margin:0 0 16px;font-size:14px;color:#6B7280;">
  Requested by <strong style="color:#3A4048;"><%= sentBy %></strong> at <%= sentAt %>.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:8px 0 0;border-top:1px solid #E4DACA;">
  <tr><td style="padding-top:20px;">
    <p style="margin:0 0 10px;font-family:'JetBrains Mono',Menlo,monospace;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:#CE4F16;">One thing this does not prove</p>
    <p style="margin:0;font-size:14px;color:#3A4048;">
      Landing in an inbox rather than a spam folder depends on the SPF, DKIM and MX records
      for this subdomain, not on the application. If this arrived in spam, that is where to look.
    </p>
  </td></tr>
</table>

<%- include('./partials/foot') %>
