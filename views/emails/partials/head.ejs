<%# Table layout and inline styles: email clients strip <style> and ignore
    flex/grid. Colours are the brand tokens, hard-coded here because a stylesheet
    cannot travel with the message. %>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= subject %></title>
</head>
<body style="margin:0;padding:0;background:#F1E5D3;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F1E5D3;padding:32px 16px;">
  <tr><td align="center">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#FBF7F0;border:1px solid #E4DACA;">

      <%# A PNG, not the SVG: Gmail and Outlook strip SVG. Served from an
          absolute URL, and the alt text carries the brand when a client blocks
          images by default — which most do on first receipt. %>
      <tr><td style="background:#21252B;padding:20px 28px;">
        <table role="presentation" cellpadding="0" cellspacing="0"><tr>
          <td style="vertical-align:middle;">
            <img src="<%= appUrl %>/img/superfeels-logo-email.png" width="64" height="58" alt="Super Feels"
                 style="display:block;border:0;outline:none;text-decoration:none;">
          </td>
          <td style="vertical-align:middle;padding-left:14px;font-family:'JetBrains Mono',Menlo,monospace;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.5);">
            Lab results
          </td>
        </tr></table>
      </td></tr>

      <tr><td style="height:3px;background:#F0701C;font-size:0;line-height:0;">&nbsp;</td></tr>

      <tr><td style="padding:34px 28px 28px;font-family:Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#3A4048;">
