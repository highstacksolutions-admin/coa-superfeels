<%
  // One panel of the results editor. `existing` is the stored panel or
  // undefined. Rows are keyed by index so client-side deletion does not
  // renumber the others; a hidden `sort` preserves order.
  var rows = existing && existing.results ? existing.results : [];
  var status = existing ? existing.status : 'not_tested';
%>
<details class="pnled" id="panel-<%= meta.key %>" <%= rows.length || status !== 'not_tested' ? 'open' : '' %>>
  <summary class="pnled__h" style="cursor:pointer;list-style:none">
    <span class="pnled__n"><%= meta.label %></span>
    <span class="pnled__c">
      <span class="status status--<%= coa.statusTone(status) %>"><%= coa.statusLabel(status) %></span>
      <span class="mono-meta"><%= rows.length %> row<%= rows.length === 1 ? '' : 's' %></span>
    </span>
  </summary>

  <div class="pnled__b">
    <form method="post" action="/admin/batches/<%= batch.id %>/results/<%= meta.key %>" data-results-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="pnled__c" style="margin-bottom:14px">
        <label class="mono-meta" for="status-<%= meta.key %>">Panel status</label>
        <select name="status" id="status-<%= meta.key %>">
          <% coa.PANEL_STATUSES.forEach(function (s) { %>
            <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= coa.statusLabel(s) %></option>
          <% }) %>
        </select>
        <input type="text" name="method" value="<%= existing && existing.method ? existing.method : '' %>" placeholder="Method (optional)">
        <input type="text" name="summary" value="<%= existing && existing.summary ? existing.summary : '' %>" placeholder="One-line summary (optional)">
      </div>

      <div class="rowgrid" data-rowgrid data-panel="<%= meta.key %>">
        <div class="rowgrid__head">
          <span>Analyte</span><span>Result</span><span>Unit</span><span>LOD</span><span>LOQ</span><span>Limit</span><span>Status</span><span></span>
        </div>
        <% rows.forEach(function (r, i) { %>
          <div class="rowgrid__row" data-row>
            <input class="analyte-in" type="text" name="rows[<%= i %>][analyte]" value="<%= r.analyte %>" placeholder="Analyte">
            <input type="text" name="rows[<%= i %>][value_text]" value="<%= r.value_text %>" placeholder="Result">
            <input type="text" name="rows[<%= i %>][unit]" value="<%= r.unit || '' %>" placeholder="<%= meta.unit %>">
            <input type="text" name="rows[<%= i %>][lod]" value="<%= r.lod || '' %>" placeholder="LOD">
            <input type="text" name="rows[<%= i %>][loq]" value="<%= r.loq || '' %>" placeholder="LOQ">
            <input type="text" name="rows[<%= i %>][limit_text]" value="<%= r.limit_text || '' %>" placeholder="Limit">
            <select name="rows[<%= i %>][status]">
              <% coa.RESULT_STATUSES.forEach(function (s) { %>
                <option value="<%= s %>" <%= r.status === s ? 'selected' : '' %>><%= coa.statusLabel(s) %></option>
              <% }) %>
            </select>
            <input type="hidden" name="rows[<%= i %>][sort]" value="<%= i %>" data-sort>
            <button type="button" class="rowgrid__del" data-del title="Remove row">×</button>
          </div>
        <% }) %>
      </div>

      <div class="pnled__add">
        <button type="button" class="btn btn--mute btn--sm" data-add-row>+ Add row</button>
        <button type="button" class="btn btn--mute btn--sm" data-toggle-paste>Paste from PDF</button>
      </div>

      <div class="paste" data-paste hidden>
        <p class="paste__d">One analyte per line. Tab- or comma-separated: <code>Analyte, Result, Unit, LOD, LOQ, Limit</code>. Only the first two are required.</p>
        <textarea data-paste-input placeholder="Delta-9 THC&#9;18.40&#9;%&#10;CBD&#9;0.05&#9;%&#10;CBG&#9;ND&#9;%"></textarea>
        <div style="margin-top:8px;display:flex;gap:8px">
          <button type="button" class="btn btn--solid btn--sm" data-paste-apply>Add these rows</button>
          <button type="button" class="btn btn--mute btn--sm" data-paste-cancel>Cancel</button>
        </div>
      </div>

      <div class="formfoot">
        <button class="btn btn--solid" type="submit">Save <%= meta.label.toLowerCase() %></button>
        <div class="formfoot__spacer"></div>
        <% if (existing) { %>
          <button class="btn btn--danger btn--sm" type="submit" formaction="/admin/batches/<%= batch.id %>/results/<%= meta.key %>/delete" data-confirm="Remove the <%= meta.label %> panel and all its rows?">Remove panel</button>
        <% } %>
      </div>
    </form>
  </div>
</details>
