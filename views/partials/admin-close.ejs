    </main>
  </div>
</div>
<div class="toast-wrap" id="toasts" role="status" aria-live="polite"></div>
<% var va = typeof asset === 'function' ? asset : function (p) { return p; } %>
<script src="<%= va('/js/app.js') %>" defer></script>
<script src="<%= va('/js/admin.js') %>" defer></script>
<% if (typeof pageScript !== 'undefined' && pageScript && pageScript !== '/js/admin.js') { %><script src="<%= va(pageScript) %>" defer></script><% } %>
</body>
</html>
